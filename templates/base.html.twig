<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">

    <title>{% block title %}Pogodynka{% endblock %}</title>

    <style>
        body {
            margin: 0;
            padding: 40px 20px;
            font-family: Arial, sans-serif;
            background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=55647");
        }

        main {
            max-width: 650px;
            margin: 0 auto;
            padding: 25px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
        }

        li {
            margin-bottom: 12px;
        }
    </style>
</head>

<body>
{% block body %}{% endblock %}
</body>
</html>
