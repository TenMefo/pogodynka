{% extends 'base.html.twig' %}

{% block title %}{{ location.city }}{% endblock %}

{% block body %}
    <section class="panel">
        <h1 class="h3">
            {{ location.city }}, {{ location.country }}
        </h1>

        <p class="mt-4">
            <strong>ID:</strong> {{ location.id }}<br>
            <strong>Szerokość:</strong> {{ location.latitude }}<br>
            <strong>Długość:</strong> {{ location.longitude }}
        </p>

        <h2 class="h5 mt-4">Wszystkie powiązane pomiary ({{ location.measurements|length }})</h2>
        <div class="table-responsive border rounded">
            <table class="table table-striped align-middle text-nowrap mb-0">
                <thead class="table-light"><tr>
                    <th scope="col" class="p-3">ID</th>
                    <th scope="col" class="p-3">Data i godzina</th>
                    <th scope="col" class="p-3 text-end">Temperatura (°C)</th>
                    <th scope="col" class="p-3 text-end">Temperatura (°F)</th>
                    <th scope="col" class="p-3 text-end">Wilgotność (%)</th>
                    <th scope="col" class="p-3 text-end">Ciśnienie (hPa)</th>
                </tr></thead>
                <tbody>
                {% for measurement in location.measurements|sort((a, b) => a.date <=> b.date) %}
                    <tr>
                        <td class="p-3"><a href="{{ path('app_measurement_show', {id: measurement.id}) }}">{{ measurement.id }}</a></td>
                        <td class="p-3">{{ measurement.date|date('d.m.Y H:i') }}</td>
                        <td class="p-3 text-end">{{ measurement.celsius ?? 'Brak danych' }}</td>
                        <td class="p-3 text-end">{{ measurement.fahrenheit ?? 'Brak danych' }}</td>
                        <td class="p-3 text-end">{{ measurement.humidity ?? 'Brak danych' }}</td>
                        <td class="p-3 text-end">{{ measurement.pressureHpa ?? 'Brak danych' }}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="6" class="p-4 text-center text-body-secondary">Brak pomiarów.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-outline-secondary" href="{{ path('app_location_index') }}">
                Wróć do listy
            </a>

            <a
                class="btn btn-primary"
                href="{{ path('app_location_edit', {'id': location.id}) }}"
            >
                Edytuj
            </a>

            <form
                method="post"
                action="{{ path('app_location_delete', {'id': location.id}) }}"
                onsubmit="return confirm('Czy na pewno usunąć tę lokalizację?');"
            >
                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('delete_location' ~ location.id) }}"
                >

                <button class="btn btn-danger">
                    Usuń lokalizację
                </button>
            </form>
        </div>

        <p class="text-body-secondary mt-3 mb-0">
            Lokalizację można usunąć, gdy nie ma przypisanych pomiarów.
        </p>
    </section>
{% endblock %}
